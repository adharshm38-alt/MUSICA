# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/musica

# ---------- Auth ----------
# CHANGE THIS to a long random string before deploying
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (comma-separate for several).
# NOTE: "localhost" and "127.0.0.1" are DIFFERENT origins to a browser, so if
# you open the app via 127.0.0.1 you must list it here too.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---------- Uploads ----------
MAX_AUDIO_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5

# ---------- YouTube (discovery only) ----------
# Google Cloud > APIs & Services > Credentials > "API key".
# Enable "YouTube Data API v3" first.
#
# This key is SERVER-SIDE ONLY. It is never sent to the browser and never
# exposed through an API response. Do not commit a real key: this file is the
# only one that may be committed, and it must contain the placeholder.
#
# MUSICA uses YouTube strictly as a DISCOVERY source and plays videos through
# YouTube's official embedded player. The app never downloads, extracts,
# caches or separates YouTube audio.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_SECONDS=86400
YOUTUBE_MAX_RESULTS=25

# ---------- Production (Render) ----------
# These values describe a container deployment. On Render they are configured as
# dashboard environment variables, never in a committed file. The variables
# below are documented so the required set is discoverable.
#
# NODE_ENV=production
# PORT is injected by the platform. Do not hardcode it.
#
# MongoDB Atlas. Copy this from Atlas > Database > Drivers. Credentials are part
# of the URI, so treat it as a secret.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/musica?retryWrites=true&w=majority
#
# CORS allowlist: the public HTTPS origin of the deployed frontend. A
# comma-separated list is supported for more than one origin.
# CLIENT_URL=https://musica-web.onrender.com
#
# Rotating JWT_SECRET invalidates every existing session, so set it once and keep
# it in the platform's secret store.
# JWT_SECRET=
#
# Set to false when the host has no persistent disk for uploaded audio. Render's
# free plan cannot attach a disk and spins down after 15 minutes idle, so
# uploads would silently vanish; the UI hides itself and the API returns 403.
# UPLOADS_ENABLED=false
