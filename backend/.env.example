# Server port (Render sets PORT automatically)
PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string (required in production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=musica

# Resend email API credentials (required for sending live Proton OTP emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=MUSICA <onboarding@resend.dev>

# Secret used to sign MUSICA Proton session JWTs (min 32 random chars in production)
JWT_SECRET=replace-with-strong-random-32-char-secret
JWT_EXPIRES_IN_DAYS=30

# Comma-separated trust-proxy setting ("true" on Render)
TRUST_PROXY=true

# Dev-only fallback flag (never enable in production)
ALLOW_DEV_CONSOLE_OTP=false
