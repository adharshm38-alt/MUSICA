# ---------- Root ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# Local MongoDB (installed on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/musica

# ---------- Auth ----------
# CHANGE THIS to a long random string before deploying (never commit real secrets)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Client (Vite) ----------
VITE_API_URL=http://localhost:5000/api

# ---------- Uploads ----------
MAX_AUDIO_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5
