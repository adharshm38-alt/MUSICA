# Base URL of the MUSICA backend API.
#
# Vite INLINES this value at build time, so it ends up inside the shipped JS
# bundle and inside the Android APK. Keep it pointed at the PUBLIC server:
#   https://adharshm38-musica-api.onrender.com/api
#
# A build made with localhost here produces an APK that can never reach MUSICA,
# because on a phone "localhost" means the phone itself.
#
# Local development: change it to http://localhost:5000/api and rebuild.
VITE_API_URL=https://adharshm38-musica-api.onrender.com/api