<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network policy: HTTPS only.

  MUSICA's production API is served over public HTTPS, and YouTube's official
  embedded player is loaded from https://www.youtube-nocookie.com. Nothing in a
  production build needs cleartext, so it is disabled outright rather than being
  allowed for every host.

  Local development against a LAN backend (http://192.168.x.x:5000) is handled by
  the sibling debug source set, which allows cleartext for specific hosts only:
    client/android/app/src/debug/res/xml/network_security_config.xml
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>