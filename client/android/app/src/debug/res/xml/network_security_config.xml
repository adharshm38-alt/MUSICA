<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network policy.

  This file lives in the debug source set, so it is used by `assembleDebug` and
  ignored by `assembleRelease`. It exists purely so that a developer can point
  the app at a local backend over plain HTTP on a LAN address.

  Cleartext is permitted for named local hosts ONLY - not for every host as the
  old configuration did. The production build (main source set) is HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Loopback, used by `adb reverse tcp:5000 tcp:5000`. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!--
          Your development machine on the LAN. Update this if your IP changes
          (it usually does when the machine reconnects to Wi-Fi). Find it with:
              hostname -I | awk '{print $1}'
          This affects DEBUG builds only; production is HTTPS-only.
        -->
        <domain includeSubdomains="false">10.28.39.200</domain>
    </domain-config>
</network-security-config>